# SmartSentinel Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit actual secrets to the repository.

# RPC Provider API Keys (used in config/chains.yml as ${KEY} references)
ALCHEMY_KEY=your_alchemy_api_key_here
INFURA_KEY=your_infura_api_key_here
QUICKNODE_KEY=your_quicknode_api_key_here

# Guardian Private Keys (one per monitored contract)
# These reference environment variable names, not actual keys
AAVE_GUARDIAN_KEY=your_aave_guardian_private_key_here

# Alert Channel Keys
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
PAGERDUTY_SERVICE_KEY=your_pagerduty_integration_key_here

# GNN Inference Server
GNN_SERVER_URL=http://localhost:8765

# Anvil Fork URL (for simulation)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}

# Application
NODE_ENV=development
AUTO_PAUSE_ENABLED=false
DRY_RUN=true